generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password      String
  phone         String?
  balance       Float           @default(0)
  walletHistory WalletHistory[]
  avatarUrl     String?
  chatTickets   Ticket[]
  createdAt     DateTime        @default(now())
  buyerChats    Chat[]          @relation("BuyerChats")
  sellerChats   Chat[]          @relation("SellerChats")
  messages      Message[]

  receiveBroadcasts Boolean @default(false)
  isBanned  Boolean   @default(false)
  banReason String?
  banUntil  DateTime?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  lots         Lot[]
  bids         Bid[]
  transactions Transaction[]

  // Новые связи
  notifications Notification[]
  tickets       SupportTicket[]
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  lots     Lot[]
}

model StatusLot {
  id   Int    @id @default(autoincrement())
  name String @unique
  lots Lot[]
}

model Lot {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  startPrice  Float
  stepMin     Float
  createdAt   DateTime @default(now())
  endTime     DateTime
  chat        Chat?

  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  statusId   Int
  status     StatusLot @relation(fields: [statusId], references: [id])
  bids         Bid[]
  images       LotImage[]
  files        LotFile[]
  transactions Transaction[]
}

model LotImage {
  id       Int    @id @default(autoincrement())
  imageUrl String
  lotId    Int
  lot      Lot    @relation(fields: [lotId], references: [id])
}

model LotFile {
  id         Int     @id @default(autoincrement())
  fileUrl    String
  fileFormat String?
  lotId      Int
  lot        Lot     @relation(fields: [lotId], references: [id])
}

model Bid {
  id           Int       @id @default(autoincrement())
  currentPrice Float
  createdAt    DateTime  @default(now())
  endTime      DateTime?

  lotId  Int
  lot    Lot  @relation(fields: [lotId], references: [id])
  userId Int
  user   User @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model StatusTransaction {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  transactions Transaction[]
}

model Transaction {
  id         Int   @id @default(autoincrement())
  finalPrice Float

  userId   Int
  user     User              @relation(fields: [userId], references: [id])
  lotId    Int
  lot      Lot               @relation(fields: [lotId], references: [id])
  bidId    Int
  bid      Bid               @relation(fields: [bidId], references: [id])
  statusId Int
  status   StatusTransaction @relation(fields: [statusId], references: [id])
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  email     String
  content   String
  reply     String? // Ответ админа
  status    String   @default("OPEN") // OPEN или CLOSED
  createdAt DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM") // SYSTEM, SUPPORT, BROADCAST
  createdAt DateTime @default(now())
}

model WalletHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  amount      Float // Положительное - пополнение, отрицательное - трата
  type        String // TOPUP, BID, BUY
  description String?
  createdAt   DateTime @default(now())
}

model Chat {
  id        Int       @id @default(autoincrement())
  lotId     Int       @unique
  lot       Lot       @relation(fields: [lotId], references: [id])
  buyerId   Int
  buyer     User      @relation("BuyerChats", fields: [buyerId], references: [id])
  sellerId  Int
  tickets   Ticket[]
  seller    User      @relation("SellerChats", fields: [sellerId], references: [id])
  status    String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  Int
  sender    User     @relation(fields: [senderId], references: [id])
  isAdmin   Boolean  @default(false)
  text      String?
  fileUrl   String?
  createdAt DateTime @default(now())
}

model Ticket {
  id        Int      @id @default(autoincrement())
  chatId    Int
  userId    Int
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])
}